{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Config is intentionally minimal. Knip's built-in plugins already resolve
  // every entry point in this pnpm workspace, so declaring them explicitly only
  // produces "redundant entry pattern" hints:
  //   - client: vite plugin follows client/index.html -> src/main.tsx
  //   - shared: package "main"/"types" -> src/index.ts
  // prototype/ is not a workspace member (see pnpm-workspace.yaml), so knip never
  // scans it — no ignore needed; write-only spike territory per ARCHITECTURE.md.
  // dist/ is build output knip skips by default. Add rules here only for things
  // knip genuinely cannot infer, each with a one-line reason.
}
