{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc -b && vite build",
    "build:analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "test": "vitest run --config vitest.worker.config.ts",
    "probe": "node scripts/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --config dist/wiki_speedrun/wrangler.json",
    "deploy": "wrangler deploy --config dist/wiki_speedrun/wrangler.json"
  },
  "dependencies": {
    "@wikispeedrun/game": "workspace:*",
    "@wikispeedrun/shared": "workspace:*",
    "dompurify": "^3.4.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright-core": "^1.61.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.114.0"
  }
}
