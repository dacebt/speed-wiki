{
  "name": "wikispeedrun",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:legacy",
    "dev:legacy": "concurrently -n server,client -c blue,magenta \"pnpm --filter server dev\" \"pnpm --filter client dev:legacy\"",
    "dev:worker": "pnpm --filter client dev:worker",
    "probe:worker": "pnpm --filter client probe:worker",
    "smoke:worker": "pnpm --filter client smoke:worker",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "vitest run && pnpm --filter client test:worker",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "knip": "^6.24.0",
    "oxlint": "^1.72.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
