{
  "name": "wikispeedrun",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter client dev",
    "probe": "pnpm --filter client probe",
    "smoke": "pnpm --filter client smoke",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "vitest run && pnpm --filter client test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "deploy:dry-run": "pnpm build && pnpm --filter client deploy:dry-run",
    "deploy": "pnpm build && pnpm --filter client deploy"
  },
  "devDependencies": {
    "knip": "^6.24.0",
    "oxlint": "^1.72.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
